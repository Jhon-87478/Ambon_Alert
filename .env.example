# Contoh variabel untuk proses deployment/build di lingkungan tepercaya.
# Halaman statis tidak membaca file .env secara langsung.
# Salin nilai publik yang diperlukan ke js/config.js saat menyiapkan deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Jangan pernah menaruh SUPABASE_SERVICE_ROLE_KEY di frontend atau repositori.
